rules_version = '2';

// Suggested rules for Word Duel online play (protocol v2).
// Deploy from the Firebase console (Firestore -> Rules) or `firebase deploy`.
//
// The app talks to Firestore without sign-in, so these rules can't tell
// players apart; they keep documents well-formed and stop the obvious abuse
// (deleting games, rewriting finished games, huge documents).
//
// Also recommended: a TTL policy on collection `games`, field `expires_at`,
// so old games are cleaned up automatically.

service cloud.firestore {
  match /databases/{database}/documents {
    match /games/{code} {
      allow read: if code.matches('^[0-9]{6}$');

      allow create: if code.matches('^[0-9]{6}$')
        && request.resource.data.v == 2
        && request.resource.data.code == code
        && request.resource.data.status == 'waiting'
        && request.resource.data.length in [4, 5, 6]
        && request.resource.data.language in ['en', 'he'];

      // Play happens while unfinished; afterwards only the reveals may be written.
      allow update: if resource.data.v == 2
        && request.resource.data.v == 2
        && request.resource.data.code == resource.data.code
        && (resource.data.status != 'finished'
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reveal_p1', 'reveal_p2']));

      allow delete: if false;
    }
  }
}
